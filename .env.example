# Pin to an explicit stable RomM release tag before deploying (avoid floating :latest)
ROMM_IMAGE_TAG=4.x.x

# PostgreSQL driver targeting existing 1Panel container on `1panel-network`
ROMM_DB_DRIVER=postgresql
DB_HOST=1Panel-postgresql-3oWY
DB_PORT=5432
DB_NAME=romm
DB_USER=romm
DB_PASSWD=CHANGE_ME_STRONG_DB_PASSWORD

# Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32

TZ=Asia/Shanghai

# Metadata scraping (enabled day-one: Hasheous hash matching + ScreenScraper free email account)
HASHEOUS_API_ENABLED=true
SCREENSCRAPER_USER=CHANGE_ME_SCREENSCRAPER_USER
SCREENSCRAPER_PASSWORD=CHANGE_ME_SCREENSCRAPER_PASSWORD

# Cloudflare Realtime TURN API (used by scripts/refresh-turn.sh to refresh 48h TTL credentials)
CLOUDFLARE_TURN_KEY_ID=CHANGE_ME_CF_TURN_KEY_ID
CLOUDFLARE_TURN_API_TOKEN=CHANGE_ME_CF_TURN_API_TOKEN

# Optional extra providers (leave empty if unused)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RETROACHIEVEMENTS_API_KEY=
